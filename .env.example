DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=replace-with-a-long-random-string
SEED_ADMIN_EMAIL=admin@racegentrade.com
SEED_ADMIN_PASSWORD=RaceAdmin2026!
# Set to true only for first deploy / empty SQLite, then set back to false
PAYLOAD_DATABASE_PUSH=false
PORT=3011
HOSTNAME=0.0.0.0

# Enquiry notification → Hostinger mailbox (required for webmail delivery)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@racegeneraltrading.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="Race General Trading <info@racegeneraltrading.com>"
ENQUIRY_NOTIFY_TO=info@racegeneraltrading.com

# Optional: Cloudflare Turnstile (bot challenge on the contact form)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: Twilio Lookup for stronger phone existence checks
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
